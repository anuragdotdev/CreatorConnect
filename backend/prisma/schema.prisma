generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Account type of a CreatorConnect profile.
enum AccountType {
  CREATOR
  BRAND
  BUSINESS
}

/// A creator, brand or business profile.
model Profile {
  id            String      @id @default(cuid())
  displayName   String
  email         String      @unique
  accountType   AccountType
  industry      String
  bio           String
  skills        String
  portfolioUrl  String?
  twitterUrl    String?
  instagramUrl  String?
  linkedinUrl   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([accountType])
  @@index([industry])
}
